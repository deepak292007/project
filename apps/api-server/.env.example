# ArogyaLink API Server Environment Variables
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/arogyalink
NODE_ENV=development
DEMO_MODE=true

JWT_SECRET=arogyalink_jwt_super_secret_key_sih_2026_production
JWT_ACCESS_SECRET=arogyalink-dev-access-secret-change-in-production
JWT_REFRESH_SECRET=arogyalink-dev-refresh-secret-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=200
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

NEMOTRON_ENABLED=true
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_NEMOTRON_API_KEY=your_openrouter_nemotron_api_key_here
NEMOTRON_MODEL=nvidia/nemotron-3-super-120b-a12b:free
NEMOTRON_TIMEOUT_MS=12000
